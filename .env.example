# Copie para .env e ajuste. O docker compose le o .env automaticamente.
# NAO coloque valores reais de token em arquivos versionados.

# Teto de qubits aceito no gateway/validacao/QASM/console (1 a 31).
# Teto fisico na Tesla P40 (24 GB, algoritmo atual): 29 em complex64, 28 em complex128.
QSIM_MAX_QUBITS=20

# Token do console web (porta 10000). Vazio = sem autenticacao (apenas dev local).
QSIM_ADMIN_TOKEN=troque-por-um-token-forte
