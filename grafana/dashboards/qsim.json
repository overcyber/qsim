{
  "title": "QSim - Visao Geral",
  "uid": "qsim-overview",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Jobs concluidos por status (/min)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (status) (rate(qsim_engine_jobs_total[1m])) * 60",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Duracao de job p50 / p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(qsim_engine_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(qsim_engine_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Jobs ativos (engines)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "sum(qsim_engine_active_jobs)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Fila do scheduler",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "qsim_scheduler_queue_depth" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Rejeicoes no gateway (/min)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [{
        "expr": "sum by (reason) (rate(qsim_gateway_rejected_total[5m])) * 60",
        "legendFormat": "{{reason}}"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Despachos por classe (/min)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "targets": [{
        "expr": "sum by (job_class) (rate(qsim_scheduler_dispatched_total[5m])) * 60",
        "legendFormat": "{{job_class}}"
      }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Qubits por job (heatmap p95)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(qsim_engine_qubits_bucket[10m])) by (le))",
        "legendFormat": "p95 qubits"
      }]
    }
  ]
}
